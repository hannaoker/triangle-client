{
  "name": "@the-triangle/agent-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": "./src/runtime.mjs",
    "./mailbox-client": "./src/mailbox-client.mjs",
    "./client-supervisor": "./src/client-supervisor.mjs",
    "./concurrency-gate": "./src/concurrency-gate.mjs",
    "./shared-codex-app-server": "./src/shared-codex-app-server.mjs",
    "./app-server-host-support": "./src/app-server-host-support.mjs",
    "./cursor-acp-runtime": "./src/cursor-acp-runtime/index.mjs",
    "./grok-bot-wake": "./src/grok-bot-wake.mjs",
    "./wake-client": "./src/wake-client.mjs",
    "./profile-scheduler": "./src/profile-scheduler.mjs",
    "./outbound-client": "./src/outbound-client.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs test/codex-runtime/*.test.mjs test/cursor-acp-runtime/*.test.mjs",
    "test:triangle-client": "npm run test --workspaces=false",
    "test:codex-runtime": "node --test test/codex-runtime/*.test.mjs",
    "test:cursor-acp-runtime": "node --test test/cursor-acp-runtime/*.test.mjs",
    "generate:codex-runtime-manifest": "node ./scripts/generate-codex-runtime-manifest.mjs",
    "soak:fake-wake": "node ../../scripts/soak-fake-wake.mjs"
  }
